:: Widget [widget]

<<widget 'maplebirchTransformationMirror'>>
  <<set $_modTransforms to Object.keys(V.maplebirch?.transformation || {}).filter(name => V.maplebirch.transformation[name].level > 0)>>
  <<for $_modTransformation range $_modTransforms>>
    <<set $_config to maplebirch.char.transformation.config.get($_modTransformation)>>
    <<set $_parts to Object.keys($transformationParts[$_modTransformation] || {}).filter(part => $transformationParts[$_modTransformation][part] !== 'disabled')>>
    <div class='settingsToggleItem'>
      <<if $_config.icon>><<= $_config.icon>><</if>>
      <span class='gold bold'><<lanSwitch 'Mods: ' '模组：'>><<= maplebirch.t($_modTransformation).convert('title')>></span>
      <<for $_partName range $_parts>><<maplebirchTransformationPartSelect $_modTransformation $_partName>><</for>>
    </div>
  <</for>>
  <<maplebirchChimeraMirror>>
<</widget>>

<<widget 'maplebirchChimeraMirror'>>
  <<set $_chimeraOptions to maplebirch.char.transformation.chimeraOptions>>
  <<if Object.values($_chimeraOptions).some(Boolean)>>
  <div class='settingsToggleItemWide'>
    <span class='gold bold'><<lanSwitch 'Mods: Chimera' '模组：融合形态'>></span>
  <<for $_chimera range maplebirch.char.transformation.chimeras>>
    <<if $_chimeraOptions[$_chimera.name + '_' + $_chimera.part]>>
      <div class='tf-part-item'>
        <<= $_chimera.label>>
        <<set $_chimeraPath to '$chimera.' + $_chimera.name + '.' + $_chimera.part>>
        <<listbox $_chimeraPath autoselect>>
          <<option `lanSwitch('Show', '显示')` true>>
          <<option `lanSwitch('Hide', '隐藏')` false>>
        <</listbox>>
      </div>
    <</if>>
  <</for>>
  </div>
  <</if>>
<</widget>>

<<widget 'maplebirchTransformationPartSelect'>>
  <<set $_modTransformation to _args[0]>>
  <<set $_partName to _args[1]>>
  <<set $_config to maplebirch.char.transformation.config.get($_modTransformation)>>
  <<set $_partConfig to $_config.parts.find(part => part.name === $_partName)>>
  <<set $_defaultValue to $_partConfig?.default || 'default'>>
  <<set $_varPath to '$transformationParts.' + $_modTransformation + '.' + $_partName>>
  <div class='tf-part-item'>
    <<if $_partConfig?.label>>
      <<= typeof $_partConfig.label === 'function' ? $_partConfig.label() : $_partConfig.label>>：
    <<else>>
      <<= maplebirch.t(String($_partName)).convert('title')>>：
    <</if>>
    <<lanListbox $_varPath autoselect class:macro-listbox>>
      <<option 'hidden' 'hidden'>>
      <<option 'default' $_defaultValue>>
    <</lanListbox>>
  </div>
<</widget>>

:: Widget [widget]

<<widget 'maplebirchCloudSave'>>
<div id="maplebirch-cloud-save" class="maplebirch-cloud-save">
  <div class="settingsToggleItemWide maplebirch-cloud-save-auth">
    <div class="maplebirch-cloud-save-note">
      <<lanSwitch 'Connect to your own Cloudflare Worker and R2. The access token protects the Worker.' '连接你自己的 Cloudflare Worker 与 R2，访问令牌用于保护 Worker。'>>
    </div>

    <label>
      <span class="gold"><<lanSwitch 'Address' '地址'>></span>
      <input type="text" data-cloud-save-field="endpoint" autocomplete="off" placeholder="https://your-worker.workers.dev">
    </label>

    <label>
      <span class="gold"><<lanSwitch 'Access Token' '访问令牌'>></span>
      <input type="password" data-cloud-save-field="token" autocomplete="off" placeholder="MAPLEBIRCH_TOKEN">
    </label>

    <div class="maplebirch-cloud-save-actions">
      <<lanButton 'cloud.save.action.connect' 'title' 'class:saveMenuButton maplebirch-cloud-save-connect'>>
        <<run maplebirch.cloudSave.panelAction('connectRemote')>>
      <</lanButton>>

      <button type="button" class="saveMenuButton" onclick="maplebirch.cloudSave.panelAction('refreshRemoteList')">
        <<lanSwitch 'Refresh' '刷新'>>
      </button>
    </div>
  </div>

  <div class="settingsToggleItemWide maplebirch-cloud-save-transfer">
    <label>
      <span class="gold"><<lanSwitch 'Local Slot' '本地槽位'>></span>
      <select data-cloud-save-field="slot">
        <option value="0">0 - <<lanSwitch 'Autosave' '自动存档'>></option>
        <option value="1" selected>1</option>
        <option value="2">2</option>
        <option value="3">3</option>
        <option value="4">4</option>
        <option value="5">5</option>
        <option value="6">6</option>
        <option value="7">7</option>
        <option value="8">8</option>
        <option value="9">9</option>
        <option value="10">10</option>
      </select>
    </label>

    <div class="maplebirch-cloud-save-actions">
      <<lanButton 'cloud.save.action.upload' 'title' 'class:saveMenuButton maplebirch-cloud-save-upload'>>
        <<run maplebirch.cloudSave.panelAction('uploadSlot')>>
      <</lanButton>>

      <button type="button" class="saveMenuButton" onclick="maplebirch.cloudSave.panelAction('exportSlotCode')">
        <<lanSwitch 'Export Slot Code' '导出槽位码'>>
      </button>
    </div>
  </div>

  <div class="settingsToggleItemWide maplebirch-cloud-save-code">
    <textarea
      data-cloud-save-field="code"
      rows="4"
      autocomplete="off"
      placeholder="<<lanSwitch 'SugarCube save code' 'SugarCube 存档码'>>"
    ></textarea>

    <div class="maplebirch-cloud-save-actions">
      <<lanButton 'cloud.save.action.code.current' 'title' 'class:saveMenuButton maplebirch-cloud-save-code-current'>>
        <<run maplebirch.cloudSave.panelAction('exportCurrentCode')>>
      <</lanButton>>

      <<lanButton 'cloud.save.action.code.upload' 'title' 'class:saveMenuButton maplebirch-cloud-save-code-upload'>>
        <<run maplebirch.cloudSave.panelAction('uploadCode')>>
      <</lanButton>>

      <<lanButton 'cloud.save.action.code.download' 'title' 'class:saveMenuButton maplebirch-cloud-save-code-download'>>
        <<run maplebirch.cloudSave.panelAction('downloadCode')>>
      <</lanButton>>

      <<lanButton 'cloud.save.action.code.load' 'title' 'class:saveMenuButton maplebirch-cloud-save-code-load'>>
        <<run maplebirch.cloudSave.panelAction('importCode')>>
      <</lanButton>>
    </div>
  </div>

  <div class="settingsToggleItemWide">
    <div class="maplebirch-cloud-save-status" data-cloud-save-status></div>
    <div class="maplebirch-cloud-save-list" data-cloud-save-list>
      <<= maplebirch.t('cloud.save.none.loaded')>>
    </div>
  </div>
</div>

<<run maplebirch.cloudSave.mountPanel()>>
<</widget>>
:: Widget [widget]

<div class='settingsGrid'>
  <div id='ConsoleCheat' class='settingsToggleItemWide'>
    <details class='JSCheatConsole'>
      <summary class='JSCheatConsole'><span class='light-blue'>JavaScript <<lanSwitch 'Code Cheater' '作弊器'>></span></summary>
      <div class='searchButtons'>
        <div class='input-row'>
          <<textbox '_maplebirch_js_cheat_console' ''>>
          <<lanButton 'execute' 'capitalize'>><<run maplebirch.tool.console.execute('javascript', _maplebirch_js_cheat_console)>><</lanButton>>
        </div>
        <span id='js-cheat-console-status'></span>
      </div>
    </details>
    <details class='TwineCheatConsole'>
      <summary class='TwineCheatConsole'>
        <span class='brightpurple'>Twine <<lanSwitch 'Code Cheater' '作弊器'>></span>
      </summary>
      <div class='searchButtons'>
        <div class='input-row'>
          <<textbox '_maplebirch_twine_cheat_console' ''>>
          <<lanButton 'execute' 'capitalize'>><<run maplebirch.tool.console.execute('twine', _maplebirch_twine_cheat_console)>><</lanButton>>
        </div>
        <span id='twine-cheat-console-status'></span>
      </div>
    </details>
  </div>
</div>
<div class='settingsGrid'>
  <div class='settingsHeader options'><<lanSwitch 'Time Travel' '时间旅行'>></div>
  <<maplebirchTimeTravel>>
</div>
<div class='settingsGrid'>
  <<set $_mod_transformations to Object.keys(V.maplebirch?.transformation || {})>>
  <div class='settingsHeader options'><<lanSwitch 'Mods Transformation' '模组转化'>></div>
  <<if $_mod_transformations.length>>
    <div class='settingsToggleItem'>
      <span class='gold'><<lanSwitch 'Transformation Type' '转化种类'>></span><br>
      <<for _mod_transformation range $_mod_transformations>>
        <<capture _mod_transformation>>
          <<set $_config to maplebirch.char.transformation.config.get(_mod_transformation)>>
          <<if $_config?.icon>><<= $_config.icon>><</if>>
          <<= maplebirch.t(_mod_transformation)>>：
          <<lanLink 'set' 'capitalize'>>
            <<run maplebirch.char.transformation.setTransform(_mod_transformation)>>
            <<updatesidebarimg>>
          <</lanLink>>
          |
          <<lanLink 'clear' 'capitalize'>>
            <<run maplebirch.char.transformation.setTransform(_mod_transformation, 0)>>
            <<updatesidebarimg>>
          <</lanLink>>
        <</capture>>
        <br>
      <</for>>
    </div>
    <div class='settingsToggleItem'>
      <span class='gold'><<lanSwitch 'Transformation Points' '转化点数'>></span><br>
      <<for _mod_transformation range $_mod_transformations>>
        <<capture _mod_transformation>>
          <<set $_config to maplebirch.char.transformation.config.get(_mod_transformation)>>
          <<set $_title to $_config?.icon ? `${$_config.icon} ${maplebirch.t(_mod_transformation)}` : maplebirch.t(_mod_transformation)>>
          <<set $_value to $maplebirch.transformation[_mod_transformation].build ?? 0>>
          <<numberStepper $_title $_value {
            callback: ((name) => (value) => {
              V.maplebirch.transformation[name].build = value;
              maplebirch.char.transformation.updateTransform(name);
              maplebirch.SugarCube.Wikifier.wikifyEval('<<updatesidebarimg>>');
            })(_mod_transformation),
            max: $_config?.build || 100,
            percentage: false,
            colorArr: ['--teal', '--purple']
          }>>
        <</capture>>
      <</for>>
    </div>
  <</if>>
</div>

{
  "name": "maplebirch",
  "version": "4.3.0",
  "private": true,
  "description": "SugarCube2-ModLoader-Degrees of Lewdity-Maplebirch Frameworks",
  "author": "楓樺葉",
  "type": "module",
  "types": "dist/maplebirch.d.ts",
  "scripts": {
    "dev": "rspack serve",
    "prep": "bun run scripts/prep.ts",
    "build": "bun run rspack -- build --mode=production",
    "build:dev": "bun run rspack -- build --mode=development",
    "types": "rolldown -c && bun run scripts/types.ts && oxfmt packages/types",
    "types:check": "bun run types && tsc --noEmit -p tests/fixtures/tsconfig.types-package.json",
    "types:pack": "bun run types:check && npm pack ./packages/types --dry-run",
    "types:publish": "bun run types:check && bun run verify && npm publish ./packages/types --access public",
    "package": "bun run scripts/package.ts",
    "package:zip": "bun run scripts/package.ts --zip-only",
    "package:modpack": "bun run scripts/package.ts --modpack-only",
    "build:all": "bun run prep && bun run build && bun run types && bun run package",
    "bump": "bumpp --no-push",
    "release": "bumpp --push --tag maplebirch-release-v%s",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "verify": "bun run test && bun run typecheck && bun run check",
    "check": "oxlint && oxfmt --check",
    "fix": "oxlint --fix && oxfmt"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "howler": "^2.2.4",
    "idb": "^8.0.3",
    "js-yaml": "^4.1.0",
    "marked": "^17.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@rspack/cli": "^2.0.8",
    "@rspack/core": "^2.0.8",
    "@scml/sc2-verlnir": "^1.0.7",
    "@scml/types": "^1.0.7",
    "@types/adm-zip": "^0.5.7",
    "@types/bun": "1.3.14",
    "@types/howler": "^2.2.12",
    "@types/jquery": "^3.5.29",
    "@types/js-yaml": "^4.0.5",
    "@types/marked": "^6.0.0",
    "@types/node": "^25.2.3",
    "@types/twine-sugarcube": "^2.37.2",
    "adm-zip": "^0.5.16",
    "bumpp": "^11.1.0",
    "oxfmt": "^0.35.0",
    "oxlint": "1.66.0",
    "pkg-types": "^2.3.0",
    "rolldown": "^1.2.0",
    "rolldown-plugin-dts": "^0.28.5",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "lastModifiedBy": "楓樺葉",
  "lastUpdate": "2026.09.11",
  "scml": {
    "nickName": {
      "en": "Maplebirch Frameworks",
      "cn": "秋枫白桦框架"
    },
    "alias": [
      "Simple Frameworks"
    ],
    "dependenceInfo": [
      {
        "modName": "ModLoader",
        "version": ">=2.0.0"
      },
      {
        "modName": "ModLoaderGui",
        "version": ">=1.0.0"
      },
      {
        "modName": "ModSubUiAngularJs",
        "version": ">=1.0.0"
      },
      {
        "modName": "ConflictChecker",
        "version": ">=1.0.0"
      },
      {
        "modName": "BeautySelectorAddon",
        "version": ">=2.0.0"
      },
      {
        "modName": "ReplacePatcher",
        "version": ">=1.0.0"
      },
      {
        "modName": "TweeReplacer",
        "version": ">=1.0.0"
      },
      {
        "modName": "GameVersion",
        "version": ">=0.5.12.11"
      }
    ]
  }
}

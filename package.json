{
  "name": "maplebirch",
  "version": "5.2.0",
  "private": true,
  "description": "SugarCube2-ModLoader-Degrees of Lewdity-Maplebirch Frameworks",
  "license": "(MIT OR CC-BY-NC-SA-4.0)",
  "author": "楓樺葉",
  "type": "module",
  "types": "dist/maplebirch.d.ts",
  "scripts": {
    "prep": "bun run scripts/prep.ts",
    "build": "rslib",
    "types": "rslib && bun run scripts/types.ts",
    "notices": "bun run scripts/notices.ts",
    "notices:check": "bun run scripts/notices.ts --check",
    "types:pack": "bun run types && npm pack ./dist --dry-run",
    "types:publish": "bun run types && bun run verify && npm publish ./dist --access public",
    "package": "bun run scripts/package.ts",
    "package:zip": "bun run scripts/package.ts --zip-only",
    "package:verify": "bun run scripts/verify-package.ts",
    "package:modpack": "bun run scripts/package.ts --modpack-only",
    "build:all": "bun run types && bun run package && bun run package:verify",
    "bump": "bumpp --no-push",
    "release": "bumpp --push --tag maplebirch-release-v%s",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test:services": "bun test tests/services",
    "verify": "bun run typecheck && bun run check && bun run notices:check",
    "check": "oxlint && oxfmt --check",
    "fix": "oxlint --fix && oxfmt"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "howler": "^2.2.4",
    "idb": "^8.0.3",
    "js-yaml": "^4.3.2",
    "marked": "^17.0.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "@rslib/core": "^1.0.2",
    "@scml/sc2-verlnir": "^1.0.7",
    "@scml/types": "^1.0.7",
    "@types/adm-zip": "^0.5.8",
    "@types/bun": "1.3.14",
    "@types/howler": "^2.2.13",
    "@types/jquery": "^3.5.34",
    "@types/js-yaml": "^4.0.9",
    "@types/marked": "^6.0.0",
    "@types/node": "^25.9.8",
    "@types/twine-sugarcube": "^2.37.2",
    "adm-zip": "^0.5.18",
    "bumpp": "^11.1.0",
    "oxfmt": "^0.35.0",
    "oxlint": "1.66.0",
    "pkg-types": "^2.3.3",
    "typescript": "^7.0.2"
  },
  "lastModifiedBy": "楓樺葉",
  "lastUpdate": "2026.10.01",
  "scml": {
    "nickName": {
      "en": "Maplebirch Frameworks",
      "cn": "秋枫白桦框架"
    },
    "alias": [
      "Simple Frameworks"
    ],
    "dependenceInfo": [
      {
        "modName": "ModLoader",
        "version": ">=2.0.0"
      },
      {
        "modName": "ModLoaderGui",
        "version": ">=1.0.0"
      },
      {
        "modName": "ModSubUiAngularJs",
        "version": ">=1.0.0"
      },
      {
        "modName": "ConflictChecker",
        "version": ">=1.0.0"
      },
      {
        "modName": "BeautySelectorAddon",
        "version": ">=2.0.0"
      },
      {
        "modName": "ReplacePatcher",
        "version": ">=1.0.0"
      },
      {
        "modName": "TweeReplacer",
        "version": ">=1.0.0"
      },
      {
        "modName": "GameVersion",
        "version": ">=0.5.12.13"
      }
    ]
  }
}
